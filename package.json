{
  "name": "@lppx/ali",
  "description": "aliyun cli tool",
  "version": "0.0.0",
  "author": "lppx",
  "bin": {
    "ali": "./bin/run.js"
  },
  "bugs": "https://github.com/lipanpan-hub/ali/issues",
  "dependencies": {
    "@alicloud/ecs20140526": "^7.7.5",
    "@alicloud/vpc20160428": "^7.2.1",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^3.2.46",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^3.2.81",
    "@oclif/plugin-version": "^2.2.42",
    "@oclif/plugin-warn-if-update-available": "^3.1.61",
    "fuse.js": "^7.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/prompts": "^2.4.9",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lipanpan-hub/ali",
  "keywords": [
    "oclif"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "BSL",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "ali",
    "dirname": "ali",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "config": {
        "description": "管理阿里云 CLI 配置"
      },
      "ecs": {
        "description": "管理 ECS 实例"
      },
      "img": {
        "description": "管理镜像"
      },
      "sgp": {
        "description": "管理安全组"
      },
      "vpc": {
        "description": "管理 VPC"
      },
      "vsw": {
        "description": "管理交换机"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init/inithook"
    }
  },
  "repository": "lipanpan-hub/ali",
  "scripts": {
    "build": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb"
  },
  "types": "dist/index.d.ts"
}
